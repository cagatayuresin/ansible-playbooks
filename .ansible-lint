---
profile: basic

skip_list:
  # This repo intentionally uses short module names (command/apt/debug etc.) and
  # existing task-name casing; FQCN + name-casing rules would require touching
  # every playbook (150+ lines) and would break the readability preference, so
  # they are skipped.
  - fqcn[action-core]
  - name[casing]
  - name[template]
  # Adding set -o pipefail to shell pipes can change behavior in some tasks
  # (e.g. commands that intentionally leave rc=1 when grep -m1 finds nothing);
  # skipped deliberately rather than adding it wholesale.
  - risky-shell-pipe
  # ignore_errors: true is an intentional pattern in this repo: a missing
  # tool/service must not stop the playbook, only show "not found" in the report.
  - ignore-errors
  # "latest" for containerd is an intentional choice (no tight version match
  # with the k8s version is required); rationale is in docs/06_update_k8s_services.md.
  - package-latest
  # There is no direct module equivalent for listing ALL failed services with
  # "systemctl --failed" (the systemd module manages a single service).
  - command-instead-of-module
  # run_once is used here with strategy: linear (the default), not free;
  # the warning does not apply to this repo.
  - run-once[task]

exclude_paths:
  - .github/
